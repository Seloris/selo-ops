        }
      }
    },
    "/v1/projects/{id}/file": {
      "get": {
        "summary": "The raw Markdown of a planning file the export lists for the project, or its ideas or technical debt",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "path",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The file's text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectFile"
                }
              }
            }
          },
          "400": {
            "description": "The path is missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such project, a path the export does not list, or a file that cannot be read",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "get": {
        "summary": "Every session of the ops export and every running session outside selo, with its derived state, and their projects",
        "responses": {
          "200": {
            "description": "The sessions and projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Session"
                      }
                    },
                    "projects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    },
                    "plugins": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/InstalledPlugin"
                      }
                    }
                  },
                  "required": [
                    "sessions",
                    "projects",
                    "plugins"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}/archive": {
      "put": {
        "summary": "Archive a session, whatever its state",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Archived"
          },
          "404": {
            "description": "The session is neither in the export nor running outside selo",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Unarchive a session",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Back in the list"
          },
          "404": {
            "description": "The session is neither in the export nor running outside selo",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}/note": {
      "put": {
        "summary": "Save the session's note, kept across runs; an empty text removes it",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Saved, or removed"
          },
          "400": {
            "description": "The text is missing or longer than 200 characters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The session is neither in the export nor running outside selo",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
