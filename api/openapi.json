{
  "openapi": "3.1.0",
  "info": {
    "title": "api",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "folder": {
            "type": "string"
          },
          "lane": {
            "type": "string"
          },
          "request": {
            "type": "string"
          },
          "isRequestCut": {
            "type": "boolean"
          },
          "blueprint": {
            "type": [
              "string",
              "null"
            ]
          },
          "step": {
            "type": [
              "string",
              "null"
            ]
          },
          "substep": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/SessionState"
          },
          "isClosed": {
            "type": "boolean"
          },
          "isArchived": {
            "type": "boolean"
          },
          "archivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "canArchive": {
            "type": "boolean"
          },
          "question": {
            "type": [
              "string",
              "null"
            ]
          },
          "permissionTool": {
            "type": [
              "string",
              "null"
            ]
          },
          "pendingCommit": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            },
            "required": [
              "subject",
              "body"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "recap": {
            "type": [
              "string",
              "null"
            ]
          },
          "commits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sha": {
                  "type": "string"
                },
                "subject": {
                  "type": "string"
                }
              },
              "required": [
                "sha",
                "subject"
              ]
            }
          },
          "nextAction": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "effort": {
            "type": [
              "string",
              "null"
            ]
          },
          "permissionMode": {
            "type": [
              "string",
              "null"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CloseBlocker"
            }
          },
          "subagents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "task": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "$ref": "#/components/schemas/SessionState"
                }
              },
              "required": [
                "type",
                "task",
                "state"
              ]
            }
          },
          "touchedFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "desktopLink": {
            "type": [
              "string",
              "null"
            ]
          },
          "isOutsideSelo": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "projectId",
          "branch",
          "folder",
          "lane",
          "request",
          "isRequestCut",
          "blueprint",
          "step",
          "substep",
          "state",
          "isClosed",
          "isArchived",
          "archivedAt",
          "canArchive",
          "question",
          "permissionTool",
          "pendingCommit",
          "error",
          "recap",
          "commits",
          "nextAction",
          "model",
          "effort",
          "permissionMode",
          "blockers",
          "subagents",
          "touchedFiles",
          "desktopLink",
          "isOutsideSelo",
          "createdAt",
          "updatedAt"
        ]
      },
      "SessionState": {
        "type": "string",
        "enum": [
          "awaiting-answer",
          "awaiting-permission",
          "awaiting-commit",
          "stopped",
          "working",
          "turn-ended",
          "job-done"
        ]
      },
      "CloseBlocker": {
        "type": "string",
        "enum": [
          "not-done",
          "pending-commit",
          "question",
          "dirty-files",
          "background-tasks",
          "subagents"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "changedCount": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "branch",
          "changedCount"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness of the API",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "status",
                    "time"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "get": {
        "summary": "Every session of the ops export and every running session outside selo, with its derived state, and their projects",
        "responses": {
          "200": {
            "description": "The sessions and projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Session"
                      }
                    },
                    "projects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    }
                  },
                  "required": [
                    "sessions",
                    "projects"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}/archive": {
      "put": {
        "summary": "Archive a session, whatever its state",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Archived"
          },
          "404": {
            "description": "The session is neither in the export nor running outside selo",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Unarchive a session",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Back in the list"
          },
          "404": {
            "description": "The session is neither in the export nor running outside selo",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
